# NeoStats Credit Risk Platform — Environment Variables
# Copy this file to .env and fill in your values
# cp .env.example .env

# ── Required ──────────────────────────────────────────────
# Anthropic API key for the Talk-to-Data NL→SQL feature
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Optional (defaults shown) ─────────────────────────────
# Path to Kaggle dataset CSVs (inside Docker: /app/data)
DATA_DIR=/app/data

# Path to saved model artifacts
MODEL_DIR=/app/models

# SQLite database path for Talk-to-Data queries
DB_PATH=/app/data/credit_risk.db
